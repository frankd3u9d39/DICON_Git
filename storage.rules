rules_version = '2';

// DICON GITH APP - Phase 1 Storage rules
service firebase.storage {
  match /b/{bucket}/o {

    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn()
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role
           in ['admin', 'super_admin'];
    }
    function isImage() { return request.resource.contentType.matches('image/.*'); }

    // Profile photos: users/{uid}/profile/*  (images, max 5 MB)
    match /users/{uid}/profile/{file} {
      allow read: if signedIn();
      allow write: if signedIn() && request.auth.uid == uid
        && isImage() && request.resource.size < 5 * 1024 * 1024;
    }

    // Innovation media: innovations/{uid}/{innovationId}/{file}
    match /innovations/{uid}/{innovationId}/{file} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin()
        || firestore.exists(/databases/(default)/documents/assignments/$(innovationId + '_' + request.auth.uid)));
      allow write: if signedIn() && request.auth.uid == uid
        && request.resource.size < 50 * 1024 * 1024
        && (isImage()
            || request.resource.contentType.matches('video/.*')
            || request.resource.contentType == 'application/pdf'
            || request.resource.contentType.matches('application/(msword|vnd.openxmlformats-officedocument.*)'));
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    match /{allPaths=**} { allow read, write: if false; }
  }
}
